{
  "name": "token-fire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-icons.mjs",
    "assets:check": "node scripts/validate-assets.mjs",
    "dev": "vite --port 1420",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "vitest run src/presentation/pixiRenderer.visual.test.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "capture:motion": "node scripts/capture-motion-reference.mjs",
    "capture:diff": "node scripts/capture-ui.mjs --baseline artifacts/ui-audit/improvement-v1-baseline --out artifacts/ui-audit/improvement-v1-diff",
    "release:check": "node scripts/check-release.mjs",
    "build": "npm run typecheck && vite build",
    "check": "npm run assets:check && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "icons": "node scripts/ensure-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-notification": "2.3.3",
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
