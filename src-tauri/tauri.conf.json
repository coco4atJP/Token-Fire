{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Fire",
  "version": "0.1.0",
  "identifier": "jp.coco4at.token-fire",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token Fire",
        "width": 560,
        "height": 350,
        "minWidth": 300,
        "minHeight": 190,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Codex activity visualized as a destructive pixel diorama",
    "longDescription": "Codex が働くほど森が燃え、止まると雨と植林で回復するドット絵デスクトップ・ジオラマ。"
  }
}
